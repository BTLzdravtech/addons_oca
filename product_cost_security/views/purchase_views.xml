<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!--
    purchase passes 'default_price': standard_price to the vendor price lines.
    standard_price is restricted to group_product_cost, so purchase users without
    it would evaluate an undefined name: the context is redefined without it.
    -->
    <record id="view_product_supplier_inherit" model="ir.ui.view">
        <field name="model">product.template</field>
        <field name="inherit_id" ref="purchase.view_product_supplier_inherit" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='seller_ids']" position="attributes">
                <attribute
                    name="context"
                >{'default_product_tmpl_id': id, 'product_template_invisible_variant': True, 'list_view_ref': 'purchase.product_supplierinfo_tree_view2'}</attribute>
            </xpath>
        </field>
    </record>
    <record id="view_product_product_supplier_inherit" model="ir.ui.view">
        <field name="model">product.product</field>
        <field
            name="inherit_id"
            ref="purchase.view_product_product_supplier_inherit"
        />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='seller_ids']" position="attributes">
                <attribute
                    name="context"
                >{'default_product_tmpl_id': product_tmpl_id, 'product_template_invisible_variant': True, 'list_view_ref': 'purchase.product_product_supplierinfo_tree_view2'}</attribute>
            </xpath>
            <xpath expr="//field[@name='variant_seller_ids']" position="attributes">
                <attribute
                    name="context"
                >{'model': 'product.product', 'active_id': id, 'list_view_ref': 'purchase.product_product_supplierinfo_tree_view2'}</attribute>
            </xpath>
        </field>
    </record>
</odoo>
